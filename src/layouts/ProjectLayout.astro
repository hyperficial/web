---
import Base from './Base.astro'
import DitherCanvas from '../components/DitherCanvas.astro'
import Footer from '../components/Footer.astro'
import MotionToggle from '../components/MotionToggle.astro'
import ThemeToggle from '../components/ThemeToggle.astro'

/**
 * Shell for the project pages: a compact brand band with the dither, then the page on the plain surface.
 *
 * Slots: `nav` (the small row above the title), `title`, `intro` (below the title), default (the page).
 */
interface Props {
	title: string
	description?: string
}

const { title, description } = Astro.props
---

<Base title={title} description={description}>
	<a
		href="#content"
		class="sr-only rounded-xl bg-ink px-4 py-3 text-surface focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50"
	>
		Skip to content
	</a>

	<div class="flex min-h-svh flex-col">
		<header class="relative isolate overflow-hidden bg-brand px-pad text-on-brand">
			<div class="absolute inset-0 -z-10" aria-hidden="true"><DitherCanvas /></div>
			<div class="mx-auto flex w-full max-w-5xl flex-col items-start gap-6 pt-pad pb-14 md:gap-8 md:pb-20">
				<div class="flex w-full flex-wrap items-center justify-between gap-x-4 gap-y-3">
					<div class="eyebrow [--muted:var(--on-brand)] [&_a]:underline-offset-4 [&_a:hover]:underline">
						<slot name="nav" />
					</div>
					<div class="-mr-2 flex items-center gap-0.5">
						<MotionToggle />
						<ThemeToggle />
					</div>
				</div>
				<slot name="title" />
				{
					Astro.slots.has('intro') && (
						<div class="flex max-w-2xl flex-col gap-4 text-lead font-medium [text-shadow:0_1px_20px_rgb(0_0_0/0.3)]">
							<slot name="intro" />
						</div>
					)
				}
			</div>
		</header>

		<main id="content" class="flex-1 scroll-mt-8 px-pad py-14 md:py-20">
			<div class="mx-auto w-full max-w-5xl">
				<slot />
			</div>
		</main>

		<Footer />
	</div>
</Base>
