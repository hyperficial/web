---
import { site } from '../site'

const year = new Date().getFullYear()
const link = 'inline-block py-2 underline-offset-4 transition-colors hover:text-ink hover:underline'
---

<footer class="px-pad pb-[max(var(--spacing-pad),env(safe-area-inset-bottom))]">
	<div
		class="mx-auto flex max-w-5xl flex-col gap-4 border-t border-line pt-6 text-sm text-muted md:flex-row md:items-center md:justify-between"
	>
		<p>© {year} {site.name}</p>
		<nav class="flex flex-wrap gap-x-6" aria-label="Footer">
			<a class={link} href={`mailto:${site.email}`}>{site.email}</a>
			<a class={link} href="/privacy">Privacy</a>
		</nav>
	</div>
</footer>
