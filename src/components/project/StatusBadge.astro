---
import { statusLabel, type Project } from '../../projects'

/** Small pill with the project status. Building gets a live dot. */
interface Props {
	status: Project['data']['status']
	class?: string
}

const { status, class: className = '' } = Astro.props
---

<span
	class:list={[
		'inline-flex items-center gap-1.5 rounded-full border border-line-strong px-2.5 py-1 font-mono text-[0.7rem] leading-none tracking-[0.12em] uppercase',
		className,
	]}
>
	<span
		class:list={[
			'size-1.5 rounded-full',
			status === 'building' && 'bg-brand',
			status === 'shipped' && 'bg-ink',
			(status === 'idea' || status === 'archived') && 'border border-current',
		]}
		aria-hidden="true"></span>
	{statusLabel[status]}
</span>
