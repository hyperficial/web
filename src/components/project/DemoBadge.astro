---
/** Marks a project that was made up to show the format, so nobody mistakes it for real work. */
interface Props {
	class?: string
}

const { class: className = '' } = Astro.props
---

<span
	class:list={[
		'inline-flex items-center rounded-full border border-dashed border-current px-2.5 py-1 font-mono text-[0.7rem] leading-none tracking-[0.12em] uppercase',
		className,
	]}
	title="A made up project that shows the format">Demo</span
>
