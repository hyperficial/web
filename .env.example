# Build-time public values (not secret). Set them as build variables in the Cloudflare dashboard.
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_CONTACT_EMAIL=

# Worker runtime secrets (set in the Cloudflare dashboard, or in .dev.vars for local development):
#   CONTACT_TO         the inbox that receives messages from the contact form
#   TURNSTILE_SECRET   the secret key of the Turnstile widget
